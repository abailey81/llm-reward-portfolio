# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.ipynb_checkpoints/

# --- Tooling ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- OS ---
.DS_Store

# --- DATA: licensed, NOT redistributable (audit C-3) ---
# Ship the pipeline + checksums + a SYNTHETIC panel of identical shape, never the gold data.
data/raw/*
data/gold/*
!data/raw/.gitkeep
!data/gold/.gitkeep
!data/**/*.sha256          # commit checksums and provenance sidecars
!data/**/*.provenance.json
# synthetic panel IS committed (safe, identical shape):
!data/synthetic/

# --- Campaign artifacts: large; keep the dir, not the runs ---
outputs/runs/*
!outputs/runs/.gitkeep
outputs/figures/*.png
outputs/figures/*.pdf
!outputs/figures/.gitkeep
outputs/tables/*.csv
outputs/tables/*.tex
!outputs/tables/.gitkeep

# --- Secrets: NEVER commit the LLM key ---
*.key
secrets.yaml
config/secrets.*

# --- LaTeX build ---
paper/**/*.aux
paper/**/*.log
paper/**/*.out
paper/**/*.bbl
paper/**/*.blg
paper/**/*.synctex.gz

# --- Merged data dirs (repo B): licensed parquets, NOT redistributable (ADR-022) ---
data/clean/*
data/staged/*
!data/clean/.gitkeep
!data/staged/.gitkeep
# ...but DO keep the provenance sidecars (2026-07-05): these later `data/clean|staged/*` rules
# overrode the earlier `!data/**/*.provenance.json` negation, so a fresh clone lost the clean/staged
# provenance JSONs (the sha256 lineage the reproducibility story cites). Re-assert them here — they
# carry checksums + lineage, never licensed payloads.
!data/clean/*.provenance.json
!data/staged/*.provenance.json
# manifest: track provenance, not the journal payloads
data/manifest/journal/
# experiment run logs (B): large; keep dir not contents
runs/*
!runs/.gitkeep
# data_pipeline never holds data payloads
data_pipeline/data/

# mutation-probe / mutmut transient cache
.mutmut-cache

# --- Internal agent operating brief (kept local; not part of the published artifact) ---
CLAUDE.md

# paper-build toolchain (portable pandoc/tectonic, 2026-07-02) + compiled artifacts
tools/
paper/_build/

# --- session hygiene (2026-07-05) ---
# Refinitiv pull venv (PowerShell-only; never commit an environment)
.venv-lseg/
# editor config: track only the deliberate settings trim
.vscode/*
!.vscode/settings.json
# run logs + transient scratch (regenerable; pilot VERDICT artifacts stay tracked)
outputs/logs/
outputs/*.log
outputs/*.err
outputs/_bytecheck/
outputs/campaign_dryrun/
outputs/crash_rehearsal/
sentinel_events.jsonl

# runtime monitoring state (docs/ops/cycle.py) - must stay untracked so the 5-minute
# publisher can `git pull --rebase` with a clean tree
docs/ops/watch/STATE.json
docs/ops/watch/CYCLE_LOG.md

# incremental-scan state for the record layers (2026-08-03, RUN 16). These are rewritten on
# every pass, so tracking them would churn the tree the status publisher rebases against. They
# were sitting UNTRACKED and permanently visible in `git status`, which is the same
# alarm-saturation shape as a permanently red guard: standing noise masks a genuinely NEW
# untracked file. Ignoring them makes `??` mean something again.
docs/analysis/.record_validator_seen.json
docs/analysis/.results_cycle_state.json
docs/ops/watch/.crash_watchdog_state.json
docs/ops/watch/.integrity_gate_last
docs/ops/watch/.record_seal_state
docs/ops/watch/.sandbox_gap_last
docs/ops/watch/.science_audit_stamp
docs/ops/watch/.sshgate/

# ---------------------------------------------------------------------------------------------
# TELEGRAM -- EVERYTHING, at Tamer's explicit instruction (2026-08-04): 'make sure absolutely
# everything about telegram is in gitignore'. This repo is pushed to GitHub roughly every 77 s by
# publish_status.sh, so anything Telegram-related that is tracked is Telegram-related that is
# PUBLISHED. It is a private repo, which lowers the blast radius but does not remove it: a token
# or an MTProto session file is a live credential and a private repo is one access-grant away from
# not being private.
#
# The CREDENTIALS do not live here at all -- they sit under %USERPROFILE%/.claude/ , outside the
# repository, so they cannot be committed even by a mistake. These patterns are the second line of
# defence, covering anything Telegram-shaped that ever lands inside the tree.
#
# CONSEQUENCE, STATED RATHER THAN HIDDEN: the bridge SCRIPT is ignored too, so it is not on the
# backup branch and would not survive losing this machine. That is the instruction as given; say
# the word and the script (never the credentials) can be tracked instead.
telegram*
*telegram*
*.session
*.session-journal
docs/ops/telegram_bridge.py
docs/ops/telegram_watch.py
docs/ops/TELEGRAM*.md
docs/ops/watch/.remote_inbox_state.json
