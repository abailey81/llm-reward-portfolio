@misc{dorka2024quantile,
  author       = {Dorka, Nicolai},
  title        = {Quantile Regression for Distributional Reward Models in {RLHF}},
  year         = {2024},
  howpublished = {arXiv preprint arXiv:2409.10164},
  note         = {Grade A. VERIFIED first-hand 2026-07-31. Quantile Reward Models learn a DISTRIBUTION over rewards instead of a scalar, via quantile regression; outperform point-estimate models on RewardBench, and the distributional estimates support downstream risk-aware RL that produces "fewer extremely negative responses". THE DISTINCTION IS SHARP AND LOAD-BEARING: their distribution is the reward model's OUTPUT (a richer signal consumed by the optimiser); ours is an INPUT to a language model acting as reward AUTHOR. Cited to anchor the four-barrier account: distributional outcome information demonstrably carries usable signal when consumed by a NUMERICAL optimiser, so a null in this study localises the failure to the LLM INTERFACE rather than to the information.},
}

