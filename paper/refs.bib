% gneiting2011making). robust_skew = the Groeneveld-Meeden gamma(0.05) quantile   %
% skewness (NOT Bowley, which is the quartile p=0.25 case), a function of the     %
% elicitable quantiles Q05/Q50/Q95 (koenkerbassett1978regression) -- NOT itself   %
% elicitable (like variance). gneiting2011making / fissler2016higherorder already %
% present -> NOT duplicated. hinkley1975 SKIPPED (GM84 subsumes it -- no noise).   %
% ============================================================================ %
@article{groeneveldmeeden1984measuring,
  author  = {Groeneveld, Richard A. and Meeden, Glen},
  title   = {Measuring Skewness and Kurtosis},
  journal = {Journal of the Royal Statistical Society, Series D (The Statistician)},
  volume  = {33}, number = {4}, pages = {391--399}, year = {1984},
  doi     = {10.2307/2987742},
  note    = {Grade A. CORRECT NAME for robust_skew: the generalized quantile skewness gamma(p)=(Q(1-p)+Q(p)-2Q(1/2))/(Q(1-p)-Q(p)); our statistic is gamma(0.05). Bowley = the p=0.25 quartile special case. Values in (-1,1), no moments required. VERIFIED 2026-07-26.},
}
